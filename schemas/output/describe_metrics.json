{
 "$defs": {
  "DateList": {
   "items": {
    "$ref": "#/$defs/date"
   },
   "maxItems": 50,
   "type": "array"
  },
  "ErrorPayload": {
   "additionalProperties": false,
   "allOf": [
    {
     "if": {
      "properties": {
       "error_type": {
        "const": "generation_mismatch"
       }
      },
      "required": [
       "error_type"
      ]
     },
     "then": {
      "properties": {
       "details": {
        "required": [
         "current_generation",
         "current_store_token"
        ]
       },
       "retryable": {
        "const": true
       }
      },
      "required": [
       "details"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "error_type": {
        "const": "store_instance_mismatch"
       }
      },
      "required": [
       "error_type"
      ]
     },
     "then": {
      "properties": {
       "details": {
        "required": [
         "current_store_token"
        ]
       },
       "retryable": {
        "const": false
       }
      },
      "required": [
       "details"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "error_type": {
        "const": "internal_error"
       }
      },
      "required": [
       "error_type"
      ]
     },
     "then": {
      "properties": {
       "details": {
        "required": [
         "incident_id"
        ]
       },
       "retryable": {
        "const": false
       }
      },
      "required": [
       "details"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "error_type": {
        "const": "storage_error"
       }
      },
      "required": [
       "error_type"
      ]
     },
     "then": {
      "properties": {
       "details": {
        "required": [
         "store_path_id",
         "cause"
        ]
       }
      },
      "required": [
       "details"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "error_type": {
        "const": "rebuild_unavailable"
       }
      },
      "required": [
       "error_type"
      ]
     },
     "then": {
      "properties": {
       "details": {
        "required": [
         "source",
         "rebuildable",
         "raw_retained"
        ]
       },
       "retryable": {
        "const": false
       }
      },
      "required": [
       "details"
      ]
     }
    }
   ],
   "properties": {
    "details": {
     "additionalProperties": false,
     "properties": {
      "affected_dates": {
       "$ref": "#/$defs/DateList"
      },
      "argument": {
       "type": "string"
      },
      "cause": {
       "enum": [
        "concurrent_swap",
        "manifest_missing",
        "manifest_multiple_rows",
        "schema_version_mismatch",
        "open_failed",
        "definition_incomplete"
       ]
      },
      "current_generation": {
       "minimum": 1,
       "type": "integer"
      },
      "current_store_token": {
       "$ref": "#/$defs/StoreToken"
      },
      "incident_id": {
       "pattern": "^[0-9a-f]{16}$",
       "type": "string"
      },
      "metric_id": {
       "$ref": "#/$defs/metric_id"
      },
      "raw_retained": {
       "type": "boolean"
      },
      "rebuildable": {
       "type": "boolean"
      },
      "source": {
       "type": "string"
      },
      "sources_unavailable": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "reason": {
          "type": "string"
         },
         "source": {
          "type": "string"
         }
        },
        "required": [
         "source",
         "reason"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "store_path_id": {
       "pattern": "^[0-9a-f]{16}$",
       "type": "string"
      },
      "unknown_hypothesis_id": {
       "type": "string"
      },
      "valid_hypothesis_ids": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "type": "object"
    },
    "error_type": {
     "enum": [
      "source_error",
      "storage_error",
      "invalid_request",
      "insufficient_evidence",
      "generation_mismatch",
      "store_instance_mismatch",
      "rebuild_unavailable",
      "internal_error"
     ]
    },
    "message": {
     "type": "string"
    },
    "payload_type": {
     "const": "error"
    },
    "remediation": {
     "type": [
      "string",
      "null"
     ]
    },
    "retryable": {
     "type": "boolean"
    },
    "schema_version": {
     "const": 7
    }
   },
   "required": [
    "schema_version",
    "payload_type",
    "error_type",
    "message",
    "retryable"
   ],
   "type": "object"
  },
  "MetricCatalogPayload": {
   "additionalProperties": false,
   "properties": {
    "generation": {
     "minimum": 1,
     "type": "integer"
    },
    "metrics": {
     "items": {
      "$ref": "#/$defs/MetricSpec"
     },
     "type": "array"
    },
    "payload_type": {
     "const": "metric_catalog"
    },
    "schema_version": {
     "const": 7
    },
    "source": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "required": [
    "schema_version",
    "payload_type",
    "generation",
    "metrics"
   ],
   "type": "object"
  },
  "MetricSpec": {
   "additionalProperties": false,
   "allOf": [
    {
     "if": {
      "properties": {
       "kind": {
        "const": "clock_time"
       }
      },
      "required": [
       "kind"
      ]
     },
     "then": {
      "properties": {
       "unit": {
        "const": "min"
       },
       "value_max": {
        "const": 1440
       },
       "value_min": {
        "const": 0
       }
      }
     }
    }
   ],
   "properties": {
    "description": {
     "type": "string"
    },
    "direction": {
     "enum": [
      "higher_is_better",
      "lower_is_better",
      "neutral"
     ]
    },
    "emits_structural_zero": {
     "type": "boolean"
    },
    "id": {
     "$ref": "#/$defs/metric_id"
    },
    "kind": {
     "enum": [
      "total",
      "mean",
      "count",
      "duration",
      "clock_time",
      "ratio"
     ]
    },
    "min_days_present_per_week": {
     "maximum": 7,
     "minimum": 1,
     "type": "integer"
    },
    "min_meaningful_delta": {
     "exclusiveMinimum": 0,
     "type": "number"
    },
    "normalization_version": {
     "minimum": 1,
     "type": "integer"
    },
    "transform": {
     "enum": [
      "none",
      "log1p"
     ]
    },
    "unit": {
     "enum": [
      "min",
      "ms",
      "kcal",
      "count",
      "degC",
      "mm",
      "pct",
      "bpm"
     ]
    },
    "value_max": {
     "type": [
      "number",
      "null"
     ]
    },
    "value_min": {
     "type": [
      "number",
      "null"
     ]
    }
   },
   "required": [
    "id",
    "unit",
    "kind",
    "direction",
    "min_meaningful_delta",
    "min_days_present_per_week",
    "emits_structural_zero",
    "transform",
    "normalization_version",
    "description"
   ],
   "type": "object"
  },
  "StoreToken": {
   "additionalProperties": false,
   "properties": {
    "generation": {
     "minimum": 1,
     "type": "integer"
    },
    "store_instance_id": {
     "pattern": "^[0-9a-f]{32}$",
     "type": "string"
    }
   },
   "required": [
    "store_instance_id",
    "generation"
   ],
   "type": "object"
  },
  "date": {
   "format": "date",
   "type": "string"
  },
  "metric_id": {
   "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
   "type": "string"
  }
 },
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "oneOf": [
  {
   "$ref": "#/$defs/MetricCatalogPayload"
  },
  {
   "$ref": "#/$defs/ErrorPayload"
  }
 ],
 "title": "describe_metrics result",
 "type": "object"
}
