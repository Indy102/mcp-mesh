{
 "$defs": {
  "DateList": {
   "items": {
    "$ref": "#/$defs/date"
   },
   "maxItems": 50,
   "type": "array"
  },
  "DateRange": {
   "additionalProperties": false,
   "properties": {
    "end": {
     "$ref": "#/$defs/date"
    },
    "start": {
     "$ref": "#/$defs/date"
    }
   },
   "required": [
    "start",
    "end"
   ],
   "type": "object"
  },
  "ErrorPayload": {
   "additionalProperties": false,
   "allOf": [
    {
     "if": {
      "properties": {
       "error_type": {
        "const": "generation_mismatch"
       }
      },
      "required": [
       "error_type"
      ]
     },
     "then": {
      "properties": {
       "details": {
        "required": [
         "current_generation",
         "current_store_token"
        ]
       },
       "retryable": {
        "const": true
       }
      },
      "required": [
       "details"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "error_type": {
        "const": "store_instance_mismatch"
       }
      },
      "required": [
       "error_type"
      ]
     },
     "then": {
      "properties": {
       "details": {
        "required": [
         "current_store_token"
        ]
       },
       "retryable": {
        "const": false
       }
      },
      "required": [
       "details"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "error_type": {
        "const": "internal_error"
       }
      },
      "required": [
       "error_type"
      ]
     },
     "then": {
      "properties": {
       "details": {
        "required": [
         "incident_id"
        ]
       },
       "retryable": {
        "const": false
       }
      },
      "required": [
       "details"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "error_type": {
        "const": "storage_error"
       }
      },
      "required": [
       "error_type"
      ]
     },
     "then": {
      "properties": {
       "details": {
        "required": [
         "store_path_id",
         "cause"
        ]
       }
      },
      "required": [
       "details"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "error_type": {
        "const": "rebuild_unavailable"
       }
      },
      "required": [
       "error_type"
      ]
     },
     "then": {
      "properties": {
       "details": {
        "required": [
         "source",
         "rebuildable",
         "raw_retained"
        ]
       },
       "retryable": {
        "const": false
       }
      },
      "required": [
       "details"
      ]
     }
    }
   ],
   "properties": {
    "details": {
     "additionalProperties": false,
     "properties": {
      "affected_dates": {
       "$ref": "#/$defs/DateList"
      },
      "argument": {
       "type": "string"
      },
      "cause": {
       "enum": [
        "concurrent_swap",
        "manifest_missing",
        "manifest_multiple_rows",
        "schema_version_mismatch",
        "open_failed",
        "definition_incomplete"
       ]
      },
      "current_generation": {
       "minimum": 1,
       "type": "integer"
      },
      "current_store_token": {
       "$ref": "#/$defs/StoreToken"
      },
      "incident_id": {
       "pattern": "^[0-9a-f]{16}$",
       "type": "string"
      },
      "metric_id": {
       "$ref": "#/$defs/metric_id"
      },
      "raw_retained": {
       "type": "boolean"
      },
      "rebuildable": {
       "type": "boolean"
      },
      "source": {
       "type": "string"
      },
      "sources_unavailable": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "reason": {
          "type": "string"
         },
         "source": {
          "type": "string"
         }
        },
        "required": [
         "source",
         "reason"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "store_path_id": {
       "pattern": "^[0-9a-f]{16}$",
       "type": "string"
      },
      "unknown_hypothesis_id": {
       "type": "string"
      },
      "valid_hypothesis_ids": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "type": "object"
    },
    "error_type": {
     "enum": [
      "source_error",
      "storage_error",
      "invalid_request",
      "insufficient_evidence",
      "generation_mismatch",
      "store_instance_mismatch",
      "rebuild_unavailable",
      "internal_error"
     ]
    },
    "message": {
     "type": "string"
    },
    "payload_type": {
     "const": "error"
    },
    "remediation": {
     "type": [
      "string",
      "null"
     ]
    },
    "retryable": {
     "type": "boolean"
    },
    "schema_version": {
     "const": 7
    }
   },
   "required": [
    "schema_version",
    "payload_type",
    "error_type",
    "message",
    "retryable"
   ],
   "type": "object"
  },
  "FetchPayload": {
   "additionalProperties": false,
   "properties": {
    "generation": {
     "minimum": 1,
     "type": "integer"
    },
    "metric_status": {
     "items": {
      "$ref": "#/$defs/MetricFetchStatus"
     },
     "minItems": 1,
     "type": "array"
    },
    "normalization_versions": {
     "additionalProperties": {
      "minimum": 1,
      "type": "integer"
     },
     "type": "object"
    },
    "observations": {
     "items": {
      "$ref": "#/$defs/Observation"
     },
     "maxItems": 2000,
     "type": "array"
    },
    "payload_type": {
     "const": "fetch"
    },
    "requested": {
     "$ref": "#/$defs/DateRange"
    },
    "schema_version": {
     "const": 7
    },
    "snapshot_id": {
     "type": "string"
    },
    "source": {
     "type": "string"
    },
    "status": {
     "enum": [
      "ok",
      "partial",
      "empty",
      "failed"
     ]
    },
    "store_token": {
     "$ref": "#/$defs/StoreToken"
    },
    "truncation": {
     "$ref": "#/$defs/Truncation"
    }
   },
   "required": [
    "schema_version",
    "payload_type",
    "source",
    "generation",
    "store_token",
    "requested",
    "observations",
    "metric_status",
    "status",
    "truncation",
    "snapshot_id",
    "normalization_versions"
   ],
   "type": "object"
  },
  "MetricFetchStatus": {
   "additionalProperties": false,
   "allOf": [
    {
     "if": {
      "properties": {
       "status": {
        "enum": [
         "failed",
         "unsupported",
         "unknown"
        ]
       }
      },
      "required": [
       "status"
      ]
     },
     "then": {
      "properties": {
       "covered": {
        "type": "null"
       },
       "known_absent_dates": {
        "maxItems": 0
       },
       "observed_dates": {
        "maxItems": 0
       },
       "present_dates": {
        "const": 0
       }
      },
      "required": [
       "reason"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "status": {
        "const": "ok"
       }
      },
      "required": [
       "status"
      ]
     },
     "then": {
      "properties": {
       "known_absent_dates": {
        "maxItems": 0
       },
       "permanently_missing_dates": {
        "maxItems": 0
       },
       "undetermined_dates": {
        "maxItems": 0
       }
      },
      "required": [
       "covered"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "status": {
        "const": "empty"
       }
      },
      "required": [
       "status"
      ]
     },
     "then": {
      "properties": {
       "observed_dates": {
        "maxItems": 0
       },
       "present_dates": {
        "const": 0
       },
       "undetermined_dates": {
        "maxItems": 0
       }
      },
      "required": [
       "covered"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "status": {
        "const": "partial"
       }
      },
      "required": [
       "status"
      ]
     },
     "then": {
      "required": [
       "covered"
      ]
     }
    }
   ],
   "properties": {
    "covered": {
     "oneOf": [
      {
       "$ref": "#/$defs/DateRange"
      },
      {
       "type": "null"
      }
     ]
    },
    "known_absent_dates": {
     "$ref": "#/$defs/DateList"
    },
    "metric_id": {
     "$ref": "#/$defs/metric_id"
    },
    "observed_dates": {
     "$ref": "#/$defs/DateList"
    },
    "omitted_dates_count": {
     "minimum": 0,
     "type": "integer"
    },
    "permanently_missing_dates": {
     "$ref": "#/$defs/DateList"
    },
    "present_dates": {
     "minimum": 0,
     "type": "integer"
    },
    "reason": {
     "type": [
      "string",
      "null"
     ]
    },
    "status": {
     "enum": [
      "ok",
      "empty",
      "partial",
      "failed",
      "unsupported",
      "truncated",
      "unknown"
     ]
    },
    "undetermined_dates": {
     "$ref": "#/$defs/DateList"
    },
    "value_definition_id": {
     "pattern": "^[0-9a-f]{32}$",
     "type": [
      "string",
      "null"
     ]
    }
   },
   "required": [
    "metric_id",
    "value_definition_id",
    "status",
    "observed_dates",
    "known_absent_dates",
    "undetermined_dates",
    "present_dates",
    "permanently_missing_dates",
    "omitted_dates_count"
   ],
   "type": "object"
  },
  "Observation": {
   "additionalProperties": false,
   "properties": {
    "date": {
     "$ref": "#/$defs/date"
    },
    "metric_id": {
     "$ref": "#/$defs/metric_id"
    },
    "normalization_version": {
     "minimum": 1,
     "type": "integer"
    },
    "quality": {
     "enum": [
      "measured",
      "derived",
      "imputed"
     ]
    },
    "sample_count": {
     "minimum": 0,
     "type": "integer"
    },
    "value": {
     "type": "number"
    }
   },
   "required": [
    "date",
    "metric_id",
    "value",
    "quality",
    "sample_count",
    "normalization_version"
   ],
   "type": "object"
  },
  "StoreToken": {
   "additionalProperties": false,
   "properties": {
    "generation": {
     "minimum": 1,
     "type": "integer"
    },
    "store_instance_id": {
     "pattern": "^[0-9a-f]{32}$",
     "type": "string"
    }
   },
   "required": [
    "store_instance_id",
    "generation"
   ],
   "type": "object"
  },
  "Truncation": {
   "additionalProperties": false,
   "allOf": [
    {
     "if": {
      "properties": {
       "truncated": {
        "const": true
       }
      },
      "required": [
       "truncated"
      ]
     },
     "then": {
      "properties": {
       "omitted_count": {
        "minimum": 1
       },
       "truncation_reason": {
        "type": "string"
       }
      },
      "required": [
       "truncation_reason"
      ]
     }
    }
   ],
   "properties": {
    "omitted_count": {
     "minimum": 0,
     "type": "integer"
    },
    "truncated": {
     "type": "boolean"
    },
    "truncation_reason": {
     "enum": [
      "row_budget",
      "item_budget",
      "source_limit",
      "deadline",
      "date_list_cap",
      null
     ],
     "type": [
      "string",
      "null"
     ]
    }
   },
   "required": [
    "truncated",
    "omitted_count"
   ],
   "type": "object"
  },
  "date": {
   "format": "date",
   "type": "string"
  },
  "metric_id": {
   "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
   "type": "string"
  }
 },
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "oneOf": [
  {
   "$ref": "#/$defs/FetchPayload"
  },
  {
   "$ref": "#/$defs/ErrorPayload"
  }
 ],
 "title": "fetch result",
 "type": "object"
}
